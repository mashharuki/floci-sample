{
  "name": "multiregion-key",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "format": "biome check --write .",
    "format:check": "biome check .",
    "lint": "biome lint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "cdk": "pnpm --filter @multiregion-key/cdk",
    "shared": "pnpm --filter @multiregion-key/shared",
    "backend": "pnpm --filter @multiregion-key/backend",
    "generate:openapi": "pnpm --filter @multiregion-key/backend generate:openapi",
    "generate:types": "openapi-typescript docs/openapi.yaml -o pkgs/shared/src/generated/api.ts",
    "generate": "pnpm generate:openapi && pnpm generate:types",
    "deploy:floci": "bash scripts/deploy.sh floci",
    "diff:aws": "bash scripts/aws-guard.sh diff",
    "deploy:aws": "bash scripts/aws-guard.sh deploy",
    "destroy:floci": "bash scripts/destroy.sh floci",
    "destroy:aws": "bash scripts/aws-guard.sh destroy"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "concurrently": "^9.2.1",
    "openapi-typescript": "^7.10.1"
  }
}
