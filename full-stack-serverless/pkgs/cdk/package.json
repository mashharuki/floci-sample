{
  "name": "@full-stack-serverless/cdk",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "synth": "cdk synth -c target=floci",
    "synth:aws": "cdk synth -c target=aws",
    "diff:aws": "cdk diff -c target=aws",
    "deploy": "cdk deploy",
    "destroy": "cdk destroy",
    "floci:up": "docker compose up -d",
    "floci:setup": "bash scripts/setup-local-aws.sh",
    "floci:down": "docker compose down",
    "floci:cdk:bootstrap": "bash scripts/floci-cdk.sh bootstrap",
    "floci:cdk:synth": "bash scripts/floci-cdk.sh synth",
    "floci:cdk:deploy": "bash scripts/floci-cdk.sh deploy --all --require-approval never",
    "floci:cdk:destroy": "bash scripts/floci-cdk.sh destroy --force"
  },
  "dependencies": {
    "aws-cdk-lib": "2.258.1",
    "constructs": "^10.5.0"
  },
  "devDependencies": {
    "@types/jest": "^30",
    "@types/node": "^24.10.1",
    "aws-cdk": "2.1126.0",
    "esbuild": "^0.28.1",
    "jest": "^30",
    "ts-jest": "^29",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  }
}
